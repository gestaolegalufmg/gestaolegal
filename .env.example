# Flask Configuration
FLASK_ENV=production

# Application Configuration
COMPANY_NAME="Gestão Legal"

# CORS Configuration
CORS_ORIGINS=http://localhost,http://localhost:5001,http://front_gl

# Frontend Configuration
PUBLIC_API_URL=/api

# Security Configuration
JWT_SECRET_KEY=your-secret-key-here-only-needed-for-production
ADMIN_SETUP_TOKEN=your-setup-token-here-for-initial-admin-creation

# Portas publicadas em 127.0.0.1 pelos dois Composes. Os valores abaixo são os
# padrões; a esteira de canteiros (scripts/helton) gera um .env por worktree com
# outras portas para que várias stacks subam ao mesmo tempo na mesma máquina.
APP_PORT=5000
DB_PORT=3306
WEB_PORT=5001

# Esteira de canteiros (scripts/helton). No checkout principal podem ficar
# vazios; nas worktrees o montar-canteiro.sh preenche.
# Nome do projeto Compose: isola containers, rede e volumes de cada worktree.
COMPOSE_PROJECT_NAME=gestaolegal
# Deslocamento de portas da worktree (0 no checkout principal). Só a esteira lê.
HELTON_OFFSET=0

# Anexos (#190)
# Raiz do volume privado onde ficam os anexos de casos, eventos e arquivos
# gerais. Precisa ficar FORA de gestaolegal/static: a pasta estática é servida
# pelo Flask em /static sem autenticação, e a subida do app recusa uma raiz que
# se sobreponha a ela. O Compose fixa o destino interno em /data/gestaolegal/uploads.
PRIVATE_FILES_ROOT=/data/gestaolegal/uploads

# Database Configuration
DB_USER=gestaolegal
DB_PASSWORD=your-database-password-here
DB_HOST=db
DB_NAME=gestaolegal

# Reset agendado: preencher SOMENTE no ambiente de demo com o mesmo DB_NAME.
# Requer FLASK_ENV=development ou testing. Apaga todo o banco.
DEMO_DB_NAME=

# MySQL Root Password (for Docker)
MYSQL_ROOT_PASSWORD=your-mysql-root-password-here

# E-mail (SMTP)
# Desenvolvimento: nome do serviço do Mailpit no compose (porta 1025, sem TLS).
# Produção: o serviço "mail" (boky/postfix) desta stack, ou o host de um relay.
MAIL_SERVER=mailpit
MAIL_PORT=1025
MAIL_USE_SSL=false
MAIL_USE_TLS=false
MAIL_DEFAULT_SENDER=nao-responda@gestaolegal.direito.ufmg.br
# Porta da interface web do Mailpit no host (desenvolvimento).
MAILPIT_UI_PORT=8025

# Postfix (só produção)
# FQDN do MTA: precisa resolver e bater com o PTR reverso do IP, senão Gmail e
# Outlook recusam ou marcam como spam.
MAIL_HOSTNAME=
# Domínios aceitos como remetente; qualquer outro é recusado. É o que impede o
# contêiner de virar relay aberto.
MAIL_ALLOWED_SENDER_DOMAINS=
# Vazio = entrega direta ao destinatário. Preenchido = repassa a um relay
# autenticado, no formato [smtp.provedor.com]:587.
MAIL_RELAYHOST=
MAIL_RELAYHOST_USERNAME=
MAIL_RELAYHOST_PASSWORD=

# Recuperação de senha
# Endereço público do frontend, usado para montar o link do e-mail. Ajuste se o
# WEB_PORT publica o web em outra porta (ex.: 5002).
FRONTEND_URL=http://localhost:5001
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Implantação (docker-compose.yml): escolha uma tag publicada de API E web.
# Ex.: SHA curto do commit aprovado. Não é necessário no Compose de desenvolvimento.
IMAGE_TAG=
# Volumes externos: em instalação existente, use os nomes reais (não crie vazios).
MYSQL_VOLUME_NAME=gestaolegal_mysql_data
UPLOADS_VOLUME_NAME=gestaolegal_uploads
MAIL_DKIM_VOLUME_NAME=gestaolegal_mail_dkim
# QA: mailpit,adminer. Produção com SMTP externo: deixe vazio.
# Produção com Postfix interno: mail (configure as variáveis MAIL_*).
COMPOSE_PROFILES=
ADMINER_PORT=8080
# Desenvolvimento: pasta de anexos, relativa à raiz do checkout.
DEV_UPLOADS_PATH=./uploads
